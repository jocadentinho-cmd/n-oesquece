# ============================================================================
# VARIÁVEIS DE AMBIENTE — NÃO ESQUECE
# ----------------------------------------------------------------------------
# Agora o app usa Supabase para login + sincronização na nuvem.
# Copie este arquivo para `.env.local` e preencha com SEUS valores
# para desenvolvimento local. No Vercel, configure as mesmas variáveis
# (Settings > Environment Variables) com prefixo VITE_.
#
# NUNCA coloque a chave SECRETA (sb_secret_ / service_role) aqui nem no Git.
# Apenas a chave publishable/anon é seguro ficar no front.
# ============================================================================

# URL base do seu projeto Supabase (ex: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave publishable / anon public do seu projeto (ex: sb_publishable_... ou eyJ...)
VITE_SUPABASE_ANON_KEY=
