# ============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE — NÃO ESQUECE
# ----------------------------------------------------------------------------
# Este projeto NÃO precisa de nenhuma variável secreta para funcionar, pois
# os dados ficam salvos no navegador (localStorage via taskService).
#
# Use este arquivo apenas se for conectar uma API externa no futuro
# (ex.: backend real de tarefas). Lembre-se do prefixo VITE_ para que as
# variáveis fiquem disponíveis no código do navegador.
#
# NUNCA coloque senhas, tokens ou API keys reais neste arquivo nem no Git.
# ============================================================================

# URL base da API futura (opcional). Deixe vazio se não usar.
# VITE_API_URL=

# Exemplo de chave pública de um serviço externo (opcional).
# VITE_PUBLIC_PUSHER_KEY=
